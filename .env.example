# GHCR image: replace owner/repository; latest or sha-<full-commit-sha>.
BOT_IMAGE=ghcr.io/dein-account/dein-repo:latest

# Documentation address: replace it with your own Bedrock server address.
BEDROCK_HOST=192.0.2.10
BEDROCK_PORT=19132
# Data/protocol version; validated server patch version: 1.26.65.
BEDROCK_VERSION=1.26.60
BEDROCK_TRANSPORT=nethernet
# Optional reachable IP for Docker-private ICE candidates; leave empty otherwise.
BEDROCK_ICE_HOST=
BOT_NAME=MCBot
CHUNK_RADIUS=4
WEB_HOST=127.0.0.1
WEB_PORT=3000
WEB_BIND=127.0.0.1
# Accept Minecraft EULA for new Block-Textures
MINECRAFT_EULA=false
