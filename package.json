{
  "name": "mc-bot",
  "version": "0.1.0",
  "private": true,
  "description": "AFK Bedrock bot with local web control",
  "engines": {
    "node": ">=24 <25"
  },
  "packageManager": "pnpm@11.25.0",
  "scripts": {
    "build": "node scripts/bump-build.cjs && tsc && node -e \"require('node:fs').cpSync('src/ui','dist/ui',{recursive:true})\" && node scripts/build-viewer.cjs",
    "start": "node dist/main.js",
    "test": "pnpm build && node --test test/*.test.cjs",
    "check:compatibility": "node scripts/check-compatibility.cjs",
    "probe:server": "node scripts/probe-server.cjs",
    "smoke:server": "tsc && node scripts/smoke-server.cjs",
    "smoke:sleep": "tsc && node --env-file-if-exists=.env scripts/smoke-sleep.cjs"
  },
  "dependencies": {
    "bedrock-protocol": "3.61.0",
    "minecraft-data": "3.119.0",
    "pngjs": "7.0.0",
    "prismarine-block": "1.23.0",
    "prismarine-chunk": "1.41.0",
    "prismarine-registry": "1.12.0",
    "prismarine-viewer": "1.33.0",
    "socket.io": "4.8.3",
    "socket.io-client": "4.8.3",
    "three": "0.128.0"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "@types/pngjs": "6.0.5",
    "assert": "2.1.0",
    "buffer": "6.0.3",
    "esbuild": "0.25.12",
    "events": "3.3.0",
    "process": "0.11.10",
    "typescript": "5.9.3"
  }
}
