diff --git a/src/nethernet/http.js b/src/nethernet/http.js
new file mode 100644
index 0000000000000000000000000000000000000000..8c37921f94abed677baf79780a1c685923465379
--- /dev/null
+++ b/src/nethernet/http.js
@@ -0,0 +1,157 @@
+const { randomBytes } = require('node:crypto')
+const { isIP } = require('node:net')
+const { EventEmitter } = require('node:events')
+const { getWebRTC } = require('nethernet/src/webrtc')
+const { Connection } = require('nethernet/src/connection')
+const { attachIdentity } = require('nethernet/src/identity')
+const { verifyServerIdentity } = require('./httpIdentity')
+
+function joinUrl (options) {
+  const url = new URL('http://localhost/v1/join')
+  url.hostname = options.host
+  url.port = options.port ?? 19132
+  return url
+}
+
+// Explicit NAT override: retain the server's UDP port and signed DTLS fingerprints.
+function rewriteIceHost (sdp, host) {
+  if (!host) return sdp
+  if (!isIP(host)) throw new Error('NetherNet iceHost must be an IP address')
+  return sdp.split(/\r?\n/).map(line => {
+    if (!line.startsWith('a=candidate:')) return line
+    const parts = line.split(' ')
+    if (parts[2]?.toLowerCase() !== 'udp') return line
+    parts[4] = host
+    return parts.join(' ')
+  }).join('\r\n')
+}
+
+// BDS 1.26.50+ uses a full-ICE HTTP offer/answer exchange, not LAN UDP signalling.
+class HttpNethernetClient extends EventEmitter {
+  constructor (options) {
+    super()
+    this.options = options
+    this.nethernet = {}
+    this.abort = new AbortController()
+    this.closed = false
+    this.connected = false
+    this.onConnected = () => {}
+    this.onCloseConnection = () => {}
+    this.onEncapsulated = () => {}
+    this.onError = () => {}
+    this.on('encapsulated', data => this.onEncapsulated({ buffer: data }))
+  }
+
+  static async ping (options, signal) {
+    const response = await fetch(joinUrl(options), {
+      signal: signal ? AbortSignal.any([signal, AbortSignal.timeout(options.pingTimeout || 5000)]) : AbortSignal.timeout(options.pingTimeout || 5000),
+      redirect: 'error'
+    })
+    if (!response.ok) throw new Error(`BDS metadata: HTTP ${response.status}`)
+    const info = await response.json()
+    if (!Number.isSafeInteger(info.protocol)) throw new Error('BDS metadata has no valid protocol number')
+    return { transport: 'nethernet', protocol: info.protocol, gameVersion: info.version, motd: info.name, levelName: info.level }
+  }
+
+  async connect () {
+    const { RTCPeerConnection } = getWebRTC(this.options.nethernet.webrtcBackend)
+    const pc = this.pc = new RTCPeerConnection({ iceServers: [], bundlePolicy: 'max-bundle' })
+    const endpoints = sdp => sdp.split(/\r?\n/).filter(line => line.startsWith('a=candidate:')).slice(0, 12).map(line => {
+      const parts = line.split(' ')
+      return parts[4] + ':' + parts[5] + '/' + parts[7]
+    }).join(', ')
+    pc.oniceconnectionstatechange = () => this.options.conLog?.(`NetherNet ICE ${pc.iceConnectionState}`)
+    const connection = this.connection = new Connection(this, randomBytes(8).readBigUInt64LE().toString(), pc)
+    const live = () => !this.closed && !connection.closed
+    const reliable = pc.createDataChannel('ReliableDataChannel', { ordered: true })
+    const unreliable = pc.createDataChannel('UnreliableDataChannel', { ordered: false, maxRetransmits: 0 })
+    reliable.binaryType = unreliable.binaryType = 'arraybuffer'
+    connection.setChannels(reliable, unreliable)
+    const opened = reliable.onopen
+    reliable.onopen = () => {
+      if (!live()) return
+      try {
+        opened?.()
+        this.connected = true
+        this.onConnected()
+      } catch (error) { this.fail(error) }
+    }
+    const receive = reliable.onmessage
+    reliable.onmessage = event => {
+      if (!live()) return
+      try {
+        if (event.data.byteLength + (connection.buf?.length || 0) > 16 * 1024 * 1024) throw new Error('NetherNet message exceeds 16 MiB')
+        receive(event)
+      } catch (error) { this.fail(error) }
+    }
+    unreliable.onmessage = event => {
+      if (!live()) return
+      try {
+        const data = Buffer.from(event.data)
+        if (data.length < 2 || data[0] !== 0) throw new Error('Invalid unreliable NetherNet frame')
+        this.onEncapsulated({ buffer: data.subarray(1) })
+      } catch (error) { this.fail(error) }
+    }
+    pc.onconnectionstatechange = () => {
+      this.options.conLog?.(`NetherNet WebRTC ${pc.connectionState}`)
+      if (live() && ['failed', 'closed', 'disconnected'].includes(pc.connectionState)) this.fail(new Error(`WebRTC ${pc.connectionState}`))
+    }
+    try {
+      const offer = await pc.createOffer()
+      if (!live()) return
+      await pc.setLocalDescription(offer)
+      if (!live()) return
+      this.options.conLog?.(`NetherNet local ICE: ${endpoints(pc.localDescription.sdp)}`)
+      const url = joinUrl(this.options)
+      url.pathname += '/' + encodeURIComponent(connection.address)
+      const response = await fetch(url, {
+        method: 'POST', headers: { 'Content-Type': 'application/sdp' },
+        body: attachIdentity(pc.localDescription.sdp, this.nethernet.identity),
+        signal: AbortSignal.any([this.abort.signal, AbortSignal.timeout(this.options.connectTimeout || 9000)]),
+        redirect: 'error'
+      })
+      if (!response.ok) throw new Error(`BDS SDP exchange: HTTP ${response.status} ${(await response.text()).slice(0, 200)}`)
+      const sdp = await response.text()
+      if (!live()) return
+      if (!sdp.startsWith('v=')) throw new Error(`BDS rejected the offer: ${sdp.slice(0, 100)} (offline login requires ONLINE_MODE=false)`)
+      if (sdp.length > 1024 * 1024 || !sdp.includes('m=application') || !sdp.includes('a=candidate:')) throw new Error('BDS returned an invalid SDP answer')
+      verifyServerIdentity(sdp, this.options.nethernet.serverKeyPath)
+      this.options.conLog?.(`NetherNet remote ICE: ${endpoints(sdp)}`)
+      // Verify the signed fingerprints and pinned operator key before removing the assertion.
+      const answer = rewriteIceHost(sdp.replace(/^a=identity:.*\r?\n/gm, ''), this.options.nethernet.iceHost)
+      if (this.options.nethernet.iceHost) this.options.conLog?.(`NetherNet effective ICE: ${endpoints(answer)}`)
+      await pc.setRemoteDescription({ type: 'answer', sdp: answer })
+    } catch (error) {
+      if (!this.closed) this.fail(error)
+    }
+  }
+
+  sendReliable (data) {
+    if (!this.connected || this.closed) throw new Error('BDS data channel is not connected')
+    return this.connection.send(data)
+  }
+
+  handleConnectionClosed (connection, reason) {
+    if (!this.closed) {
+      this.close()
+      this.onCloseConnection(reason)
+    }
+  }
+
+  fail (error) {
+    if (this.closed) return
+    try { this.onError(error) } finally { this.close() }
+  }
+
+  close () {
+    if (this.closed) return
+    this.closed = true
+    this.connected = false
+    this.abort.abort()
+    // Connection.close invokes the async peer close; consume that promise as well.
+    this.connection?.close()
+    Promise.resolve(this.pc?.close()).catch(() => {})
+  }
+}
+
+module.exports = { HttpNethernetClient, rewriteIceHost }
diff --git a/src/nethernet/httpIdentity.js b/src/nethernet/httpIdentity.js
new file mode 100644
index 0000000000000000000000000000000000000000..b75f9d0ebf4378a035c222ce656ec5fa9d481a5a
--- /dev/null
+++ b/src/nethernet/httpIdentity.js
@@ -0,0 +1,39 @@
+const crypto = require('node:crypto')
+const fs = require('node:fs')
+const path = require('node:path')
+const JWT = require('jsonwebtoken')
+const { extractFingerprints, fingerprintsPayload } = require('nethernet/src/identity')
+
+function verifyServerIdentity (sdp, pinPath) {
+  if (!pinPath) throw new Error('HTTP NetherNet requires a serverKeyPath for operator-key pinning')
+  const identities = sdp.split(/\r?\n/).filter(line => line.startsWith('a=identity:'))
+  if (identities.length !== 1) throw new Error('Expected one BDS server identity assertion')
+  const envelope = JSON.parse(Buffer.from(identities[0].slice(11), 'base64').toString('utf8'))
+  const assertion = JSON.parse(envelope.assertion)
+  const decoded = JWT.decode(assertion.token)
+  if (!decoded?.cpk) throw new Error('BDS server identity has no public key')
+  const cpk = decoded.cpk
+  const key = typeof cpk === 'object'
+    ? crypto.createPublicKey({ key: cpk, format: 'jwk' })
+    : crypto.createPublicKey(cpk.includes('BEGIN') ? cpk : { key: Buffer.from(cpk, 'base64'), format: 'der', type: 'spki' })
+  JWT.verify(assertion.token, key, { algorithms: ['ES256', 'ES384'] })
+  const [header, payload, signature, extra] = assertion.fingerprints.split('.')
+  const algorithm = JSON.parse(Buffer.from(header, 'base64url').toString('utf8')).alg
+  const digest = { ES256: 'sha256', ES384: 'sha384' }[algorithm]
+  const fingerprints = extractFingerprints(sdp)
+  if (!digest || payload !== '' || extra !== undefined || !signature || fingerprints.length === 0) throw new Error('Invalid BDS fingerprint assertion')
+  const canonical = Buffer.from(fingerprintsPayload(fingerprints)).toString('base64url')
+  if (!crypto.verify(digest, Buffer.from(header + '.' + canonical), { key, dsaEncoding: 'ieee-p1363' }, Buffer.from(signature, 'base64url'))) throw new Error('BDS fingerprint signature is invalid')
+  const fingerprint = crypto.createHash('sha256').update(key.export({ format: 'der', type: 'spki' })).digest('hex')
+  // First connection trusts the configured LAN endpoint; later connections reject key changes.
+  fs.mkdirSync(path.dirname(pinPath), { recursive: true })
+  try {
+    fs.writeFileSync(pinPath, fingerprint + '\n', { flag: 'wx', mode: 0o600 })
+  } catch (error) {
+    if (error.code !== 'EEXIST') throw error
+    if (fs.readFileSync(pinPath, 'utf8').trim() !== fingerprint) throw new Error('BDS operator key changed; verify the server before replacing its pin')
+  }
+  return fingerprint
+}
+
+module.exports = { verifyServerIdentity }
